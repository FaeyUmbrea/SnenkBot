{
	"name": "snenkbot-desktop",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint . --max-warnings 0",
		"test": "vitest run --maxWorkers 2",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"tauri": "cd ../crates/snenkbot_desktop && tauri",
		"desktop:build": "npm run tauri -- build -- --jobs 2",
		"desktop:bundle": "npm run tauri -- bundle",
		"desktop:build:mac-dev": "npm run tauri -- build --debug --config tauri.macos-dev.conf.json --ci -- --jobs 2"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.1",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tauri-apps/cli": "^2.12.1",
		"@testing-library/svelte": "^5.0.0",
		"@types/node": "^24.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^27.0.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.11"
	}
}
