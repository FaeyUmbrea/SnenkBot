                                compound: control.kind == "if" || control.kind == "while" || control.kind == "one_or_more";
                                enabled: root.can-add-action && root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode != 2 && root.active-field == "" && !root.trigger-editing && !root.edit-pending && !root.rename-active;
                                choose(kind, version) => { root.sidepanel-tab = 1; root.begin-control(kind); }
                            }
