                                background: step.depth > 0 || step.group-end ? Theme.side : transparent;
                                border-top-left-radius: step.depth == 0 && !step.group-end ? 8px : 0px;
                                border-top-right-radius: step.depth == 0 && !step.group-end ? 8px : 0px;
                                border-bottom-left-radius: step.group-end ? 8px : 0px;
                                border-bottom-right-radius: step.group-end ? 8px : 0px;
                                if step.depth > 0: Rectangle {
