                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.control-kind != "if": IconButton { icon: @image-url("../assets/icons/plus.svg"); background: Theme.field; accessible-label: "Add action to this group"; clicked => { root.begin-control-child("body"); } }
                                    if root.control-kind == "if": AppButton { text: "Add to Then"; clicked => { root.begin-control-child("then"); } }
                                    if root.control-kind == "if": AppButton { text: "Add to Else"; clicked => { root.begin-control-child("else"); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                        Rectangle { height: 24px; }
                        if root.can-add-action && root.control-mode == 0: AppButton { text: "Add action"; icon: @image-url("../assets/icons/plus.svg"); width: 136px; enabled: !root.value-visible && root.control-mode == 0 && root.action-mode == 0 && root.trigger-mode == 0 && !root.edit-pending && root.active-field == "" && !root.rename-active; clicked => { root.add-action(); } }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 24px;
                            TouchArea {
                                enabled: root.action-mode != 2 && root.control-mode == 0 && root.trigger-mode != 2 && !root.edit-pending && !root.rename-active;
                                clicked => { root.selected-step = ""; root.select-step(""); root.sidepanel-tab = 1; }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 36px;
                    Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.border; }
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        Text { text: "Actions run in order"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle {
                width: Theme.inspector-width;
                background: Theme.side;
                Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.border; }
                VerticalLayout {
                    spacing: 0px;
                Rectangle {
                    visible: !root.choice-visible && !root.value-visible;
                    min-height: root.choice-visible || root.value-visible ? 0px : 68px;
                    max-height: root.choice-visible || root.value-visible ? 0px : 68px;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 16px;
                        width: 80px;
                        height: 36px;
                        background: #28201D;
                        border-radius: 18px;
                        IconButton {
                            x: 4px;
                            y: 2px;
