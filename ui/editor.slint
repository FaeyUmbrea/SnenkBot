                            if root.trigger-kind == "manual": Text { text: "Run this automation from the play button."; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            if root.trigger-error != "": Text { text: root.trigger-error; color: Theme.gold; wrap: word-wrap; }
                        }
                        if root.trigger-mode == 0 && root.action-mode == 2: Text { text: root.action-title; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                        if root.trigger-mode == 0 && root.action-mode == 2: Text { text: "Configure action"; color: Theme.muted; font-size: 12px; }
                        if root.trigger-mode == 0 && root.action-mode == 2: VerticalLayout {
                          spacing: Theme.space-3;
