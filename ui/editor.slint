                        alignment: start;
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;
                                Text { text: "Triggers"; color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                if root.can-add-trigger: IconButton { icon: @image-url("../assets/icons/plus.svg"); accessible-label: "Add trigger"; enabled: !root.value-visible && root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode == 0 && !root.edit-pending && root.active-field == "" && !root.rename-active; clicked => { root.add-trigger(); } }
                            }
                            for trigger in root.triggers: StepRow { trigger: true; step: trigger; selected: root.selected-step == trigger.id; enabled: !root.value-visible && root.control-mode == 0 && root.action-mode != 2 && root.trigger-mode != 2; activate(id) => { root.selected-step = id; root.select-step(id); root.sidepanel-tab = 1; root.edit-trigger(id); } }
                        }
                        Rectangle { height: 24px; }
                        Text { text: "Actions"; color: Theme.muted; font-size: 13px; height: 16px; }
                        Rectangle { height: 16px; }
                        if root.steps.length == 0: Text { text: "No actions yet"; color: Theme.muted; font-size: 13px; }
                        VerticalLayout {
                            spacing: 0px;
                            for step[index] in root.steps: VerticalLayout {
