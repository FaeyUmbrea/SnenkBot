                            accessible-label: "Actions tab";
                            clicked => { root.sidepanel-tab = 0; }
                        }
                        IconButton {
                            x: 42px;
                            y: 2px;
                            width: 34px;
                            icon: @image-url("../assets/icons/info.svg");
                            background: root.sidepanel-tab == 1 ? #3B2F2A : transparent;
                            accessible-label: "Details tab";
                            clicked => { root.sidepanel-tab = 1; }
                        }
                    }
