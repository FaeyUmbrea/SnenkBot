                    max-height: root.choice-visible || root.value-visible ? 0px : 100000px;
                    vertical-stretch: root.choice-visible || root.value-visible ? 0 : 1;
                ScrollView {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.sidepanel-tab == 0;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-bottom: 24px;
                        spacing: 4px;
                        alignment: start;
                        Rectangle {
                            height: 32px;
                            background: Theme.ink;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: action-search.has-focus ? Theme.gold : transparent;
                            Image { source: @image-url("../assets/icons/search.svg"); colorize: Theme.muted; x: 10px; y: 8px; width: 16px; height: 16px; }
                            if root.action-query == "": Text { x: 34px; y: 7px; text: "Search actions"; color: Theme.muted; font-size: 13px; }
                            action-search := TextInput {
                                x: 34px;
                                y: 5px;
                                width: parent.width - 44px;
                                height: 22px;
