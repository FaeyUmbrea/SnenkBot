                                        clicked => { if root.control-mode == 1 { root.begin-control-child(step.control-kind); } else { root.add-child(step.parent-id, step.control-kind); } }
                                    }
                                }
                                if !step.group-end && !step.branch-header: StepRow {
                                  x: min(step.depth, 5) * 20px + (step.depth > 0 ? 8px : 0px);
