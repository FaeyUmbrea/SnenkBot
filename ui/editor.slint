                            Text { text: root.control-title; color: Theme.text; font-size: 17px; font-weight: 600; }
                            if root.control-kind == "one_or_more": Rectangle { height: 12px; }
                            if root.control-kind == "one_or_more": Text { text: "Try every action. Succeed when at least one succeeds."; color: Theme.muted; wrap: word-wrap; }
                            if root.control-kind == "one_or_more": Rectangle { height: 24px; }
                            if root.control-kind == "one_or_more": Text { text: "Actions run in order. All results appear in run history."; color: Theme.muted; wrap: word-wrap; }
                            for field in root.control-fields: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: field.label; color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                    if field.id == "left" || field.id == "right" || field.id == "value": IconButton {
                                        icon: @image-url("../assets/icons/zap.svg");
                                        accessible-label: "Choose value for " + field.label;
                                        enabled: !root.edit-pending;
                                        clicked => { root.request-control-values(field.id); }
                                    }
                                }
                                if field.choices.length > 0: ControlSelect {
                                    choices: field.choices;
                                    value: field.value;
                                    display-value: field.display-value;
                                    label: field.label;
                                    enabled: field.editable && !root.edit-pending;
                                    chosen(value) => { root.update-control-field(field.id, value); }
                                }
                                if field.choices.length == 0 && field.editable && field.kind != EditorFieldKind.toggle: Rectangle {
                                    height: 36px;
                                    background: Theme.field;
                                    border-radius: 4px;
                                    border-width: control-edit.has-focus ? 1px : 0px;
                                    border-color: Theme.gold;
                                    control-edit := TextInput {
                                        x: 12px; y: 7px; width: parent.width - 24px; height: 22px;
                                        text: field.value;
                                        accessible-label: field.label;
                                        color: Theme.text;
                                        enabled: !root.edit-pending;
                                        edited => { root.update-control-field(field.id, self.text); }
                                    }
                                }
                                if field.choices.length == 0 && field.editable && field.kind == EditorFieldKind.toggle: ControlSelect {
                                    label: field.label;
                                    choices: [{kind: "true", title: "True"}, {kind: "false", title: "False"}];
                                    value: field.value;
                                    display-value: field.value == "true" ? "True" : "False";
                                    enabled: !root.edit-pending;
                                    chosen(value) => { root.update-control-field(field.id, value); }
                                }
                                if !field.editable && (field.id == "left" || field.id == "right" || field.id == "value"): AppButton {
                                    text: "Use literal"; enabled: !root.edit-pending;
                                    clicked => { root.request-control-literal(field.id); }
                                }
                                if !field.editable: ValueField { text: field.display-value; output: true; enabled: false; }
                            }
                            if root.control-error != "": Text { text: root.control-error; color: Theme.gold; wrap: word-wrap; }
                        }
                        if root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode == 0: VerticalLayout {
                          spacing: Theme.space-2;
                          if root.selected-step.starts-with("trigger:"): VerticalLayout {
                          spacing: 0px;
                          for trigger in root.triggers: VerticalLayout {
                            visible: root.selected-step == trigger.id;
                            min-height: 0px;
                            max-height: root.selected-step == trigger.id ? 100000px : 0px;
                            spacing: Theme.space-2;
                            Text { text: trigger.label; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                            Text { text: trigger.detail; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            if root.trigger-editing && root.trigger-edit-kind == "obs.current_scene": VerticalLayout {
                                spacing: 8px;
                                Text { text: "Scene name"; color: Theme.muted; font-size: 13px; }
                                AppTextField { text <=> root.trigger-edit-scene; label: "Scene name"; enabled: !root.trigger-pending; }
                            }
                            if root.trigger-editing && root.trigger-edit-kind == "twitch.chat.command": VerticalLayout {
                                spacing: 8px;
                                Text { text: "Command"; color: Theme.muted; font-size: 13px; }
                                AppTextField { text <=> root.trigger-edit-command; label: "Command"; enabled: !root.trigger-pending; }
                                Text { text: "Aliases (comma separated)"; color: Theme.muted; font-size: 13px; }
                                AppTextField { text <=> root.trigger-edit-aliases; label: "Aliases"; enabled: !root.trigger-pending; }
                                AppCheckBox { text: "Broadcaster or moderator only"; checked <=> root.trigger-edit-moderator; enabled: !root.trigger-pending; }
                            }
                            if root.trigger-editing && root.trigger-error != "": Text { text: root.trigger-error; color: Theme.gold; wrap: word-wrap; }
                            AppButton {
                                text: root.selected-trigger-enabled ? "Disable trigger" : "Enable trigger";
                                icon: @image-url("../assets/icons/power.svg");
                                enabled: root.can-edit-fields && !root.edit-pending && !root.trigger-editing;
                                clicked => { root.set-trigger-enabled(trigger.id, !root.selected-trigger-enabled); }
                            }
                        }
                          }
                          if !root.selected-step.starts-with("trigger:"): VerticalLayout {
                          spacing: 0px;
                          for step in root.steps: VerticalLayout {
                            visible: !step.group-end && root.selected-step == step.id;
                            min-height: 0px;
                            max-height: !step.group-end && root.selected-step == step.id ? 100000px : 0px;
                            spacing: Theme.space-2;
                            Text { text: step.label; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                            if root.inspector-fields.length == 0: Text { text: step.detail; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            if step.control-kind != "" && root.can-edit-fields: AppButton {
                                text: "Edit " + step.label;
                                icon: @image-url("../assets/icons/pencil.svg");
                                enabled: !root.edit-pending && root.active-field == "";
                                clicked => { root.edit-control(step.id); }
                            }
                            if (step.control-kind == "while" || step.control-kind == "one_or_more") && root.can-edit-fields: AppButton {
                                text: "Add action";
                                icon: @image-url("../assets/icons/plus.svg");
                                enabled: root.can-add-action && !root.edit-pending && root.active-field == "";
                                clicked => { root.add-child(step.id, "body"); }
                            }
                            if step.control-kind == "if" && root.can-edit-fields: HorizontalLayout {
                                spacing: 8px;
                                AppButton { text: "Add to Then"; enabled: root.can-add-action && !root.edit-pending && root.active-field == ""; clicked => { root.add-child(step.id, "then"); } }
                                AppButton { text: "Add to Else"; enabled: root.can-add-action && !root.edit-pending && root.active-field == ""; clicked => { root.add-child(step.id, "else"); } }
                            }

                        }
                          }
                          for field in root.inspector-fields: VerticalLayout {
                            spacing: Theme.space-2;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: field.label; color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                if root.can-edit-fields && field.kind != EditorFieldKind.secret: IconButton {
                                    icon: @image-url("../assets/icons/zap.svg");
                                    accessible-label: "Choose value for " + field.label;
                                    enabled: !root.edit-pending && root.active-field == "";
                                    clicked => { root.request-action-values(field.id); }
                                }
                            }
                            if field.description != "": Text { text: field.description; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            if root.active-field != field.id: HorizontalLayout {
                                spacing: Theme.space-2;
                                ValueField {
                                    text: field.value;
                                    output: field.is-output;
                                    source-icon: @image-url("../assets/icons/zap.svg");
                                    enabled: root.can-edit-fields && field.editable && field.has-choices && !root.edit-pending && root.active-field == "";
                                    horizontal-stretch: 1;
                                    choose => { root.request-choices(field.id, false); }
                                }
                                if root.can-edit-fields && field.is-output && field.kind != EditorFieldKind.secret: AppButton {
                                    text: "Use literal";
                                    enabled: !root.edit-pending && root.active-field == "";
                                    clicked => { root.request-action-literal(field.id); }
                                }
                                if root.can-edit-fields && field.editable: AppButton {
                                    text: field.has-choices ? "Choose" : field.configured ? "Edit" : "Add";
                                    enabled: root.active-field == "" && !root.edit-pending && !root.rename-active;
                                    clicked => { if field.has-choices { root.request-choices(field.id, false); } else { root.active-field = field.id; root.draft-value = field.configured ? field.value : field.kind == EditorFieldKind.toggle ? "false" : ""; root.edit-error = ""; } }
                                }
                                if root.can-edit-fields && field.editable && field.configured && field.optional: IconButton {
                                    icon: @image-url("../assets/icons/x.svg");
                                    accessible-label: "Remove " + field.label;
                                    enabled: root.active-field == "" && !root.edit-pending && !root.rename-active;
                                    clicked => { root.remove-field(root.selected-step, field.id); }
                                }
                            }
                            if root.active-field == field.id: VerticalLayout {
                                spacing: Theme.space-2;
                                if field.has-choices: AppButton { text: root.draft-value; icon: @image-url("../assets/icons/chevron-down.svg"); enabled: !root.edit-pending; clicked => { root.request-choices(field.id, false); } }
                                if field.kind != EditorFieldKind.toggle && !field.has-choices: Rectangle {
                                    height: field.id == "message" ? 112px : 36px;
                                    background: Theme.field;
                                    border-width: 1px;
                                    border-color: edit.has-focus ? Theme.gold : Theme.border;
                                    border-radius: 4px;
                                    edit := TextInput {
                                        x: 10px;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width - 20px;
                                        height: parent.height - 16px;
                                        text <=> root.draft-value;
                                        accessible-label: field.label;
                                        color: Theme.text;
                                        selection-background-color: Theme.blood;
                                        selection-foreground-color: Theme.text;
                                        enabled: !root.edit-pending;
                                        single-line: field.id != "message";
                                        wrap: word-wrap;
                                    }
                                }
                                if field.kind == EditorFieldKind.toggle: AppButton {
                                    text: root.draft-value == "true" ? "On" : "Off";
                                    enabled: !root.edit-pending;
                                    clicked => { root.draft-value = root.draft-value == "true" ? "false" : "true"; }
                                }
                                if root.edit-error != "": Text { text: root.edit-error; color: Theme.gold; wrap: word-wrap; }

                            }
                        }
                          }
                        Rectangle { height: 24px; }
                        @children
                    }
                }
                }
                if root.value-visible: ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        alignment: start;
                        Text { text: "Choose a value"; color: Theme.text; font-size: 17px; font-weight: 600; }
                        if root.value-choices.length == 0: Text { text: "No values are available before this step."; color: Theme.muted; wrap: word-wrap; }
                        for choice[index] in root.value-choices: VerticalLayout {
                            spacing: 4px;
                            AppButton {
                                text: choice.label;
                                primary: index == root.value-selected;
                                clicked => { root.select-control-value(index); }
                            }
                            Text { text: choice.detail; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            if choice.optional: Text { text: "May be unavailable · fallback required"; color: Theme.amber; font-size: 12px; }
                        }
                        if root.value-selected >= 0 && root.value-choices[root.value-selected].optional: VerticalLayout {
                            spacing: 8px;
                            Text { text: "Use this when the value is unavailable"; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                            ControlSelect {
                                label: "Fallback type";
                                choices: root.control-input-types;
                                value: root.value-fallback-kind;
                                display-value: root.value-fallback-kind == "number" ? "Number" : root.value-fallback-kind == "toggle" ? "On or Off" : root.value-fallback-kind == "text" ? "Text" : "Choose type";
                                chosen(kind) => { root.set-value-fallback(kind, root.value-fallback-value); }
                            }
                            if root.value-fallback-kind != "toggle": Rectangle {
                                height: 36px; background: Theme.field; border-radius: 4px;
                                fallback-edit := TextInput {
                                    x: 12px; y: 7px; width: parent.width - 24px; height: 22px;
                                    text <=> root.value-fallback-value;
                                    color: Theme.text;
                                    accessible-label: "Fallback value";
                                    edited => { root.set-value-fallback(root.value-fallback-kind, self.text); }
                                }
                            }
                            if root.value-fallback-kind == "toggle": ControlSelect {
                                label: "Fallback value";
                                choices: [{kind: "true", title: "True"}, {kind: "false", title: "False"}];
                                value: root.value-fallback-value;
                                display-value: root.value-fallback-value == "true" ? "True" : root.value-fallback-value == "false" ? "False" : "Choose a value";
                                chosen(value) => { root.set-value-fallback("toggle", value); }
                            }
                        }
                        if root.value-error != "": Text { text: root.value-error; color: Theme.gold; wrap: word-wrap; }
                    }
                }
                if root.value-visible: Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding: 16px; spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: "Cancel"; width: 88px; clicked => { root.cancel-control-values(); } }
                        AppButton { text: "Done"; width: 88px; primary: true; enabled: root.value-selected >= 0; clicked => { root.confirm-control-value(); } }
                    }
                }
                if root.choice-visible: ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        alignment: start;
                        Text { text: root.choice-title; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                        if root.choice-loading: Text { text: "Loading…"; color: Theme.muted; }
                        if root.choice-error != "": Text { text: root.choice-error; color: Theme.gold; wrap: word-wrap; }
                        if !root.choice-loading && root.choice-error == "" && root.choices.length == 0: Text { text: "No resources are available."; color: Theme.muted; wrap: word-wrap; }
                        for choice in root.choices: AppButton {
                            text: choice.label;
                            accessible-label: "Choose " + choice.label;
                            enabled: !root.choice-loading;
                            clicked => { root.choose-resource(choice.value); }
                        }
                    }
                }
                if root.choice-visible: Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding: 16px;
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: "Back"; width: 88px; clicked => { root.cancel-choices(); } }
                    }
                }
                if root.sidepanel-tab == 1 && !root.choice-visible && !root.value-visible && (root.control-mode != 0 || root.active-field != "" || root.trigger-mode == 1 || root.trigger-mode == 2 || root.trigger-editing || root.action-mode == 1 || root.action-mode == 2): Rectangle {
                    height: 64px;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: Theme.space-6;
                        padding-right: Theme.space-6;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: Theme.space-2;
                        Rectangle { horizontal-stretch: 1; }
                        if root.control-mode == 1 && root.action-mode == 0: AppButton { text: "Cancel"; width: 88px; enabled: !root.edit-pending; clicked => { root.cancel-control(); } }
                        if root.control-mode == 1 && root.action-mode == 0: AppButton { text: "Done"; width: 88px; primary: true; enabled: !root.edit-pending; clicked => { root.save-control(); } }
                        if root.active-field != "": AppButton {
                            text: "Cancel";
                            width: 88px;
                            enabled: !root.edit-pending;
                            clicked => { root.active-field = ""; root.edit-error = ""; }
                        }
                        if root.active-field != "": AppButton {
                            text: "Done";
                            width: 88px;
                            primary: true;
                            enabled: !root.edit-pending;
                            clicked => { root.apply-field(root.selected-step, root.active-field, root.draft-value); }
                        }
                        if root.trigger-mode == 0 && root.action-mode == 1: AppButton {
                            text: "Back to editor";
                            primary: true;
                            clicked => { root.back(); }
                        }
                        if root.trigger-mode == 0 && root.action-mode == 2: AppButton {
                            text: "Cancel";
                            enabled: !root.edit-pending;
                            clicked => { root.cancel-action(); }
                        }
                        if root.trigger-mode == 0 && root.action-mode == 2: AppButton {
                            text: "Add action";
                            primary: true;
                            enabled: !root.edit-pending;
                            clicked => { root.save-action(); }
                        }
                        if root.trigger-mode == 1 || root.trigger-mode == 2: AppButton {
                            text: "Cancel";
                            enabled: !root.trigger-pending;
                            clicked => { root.cancel-trigger(); }
                        }
                        if root.trigger-mode == 2: AppButton {
                            text: "Done";
                            primary: true;
                            enabled: !root.trigger-pending && (root.trigger-kind != "obs.current_scene" || (root.trigger-scene != "" && root.trigger-scene != " "));
                            clicked => { root.save-trigger(); }
                        }
                        if root.trigger-editing: AppButton { text: "Cancel"; width: 88px; enabled: !root.trigger-pending; clicked => { root.cancel-trigger-edit(); } }
                        if root.trigger-editing: AppButton { text: "Done"; width: 88px; primary: true; enabled: !root.trigger-pending; clicked => { root.save-trigger-edit(); } }
                    }
                }
                }
            }
        }
    }
}
