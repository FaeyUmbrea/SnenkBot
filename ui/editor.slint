                            Text { text: field.label; color: Theme.muted; font-size: 13px; }
                            if field.description != "": Text { text: field.description; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            if !field.required && !field.configured: AppButton {
                                text: "Add";
                                clicked => { root.update-action-field(index, "", true); }
                            }
                            if field.configured: HorizontalLayout {
                                spacing: Theme.space-2;
                                if field.has-choices: AppButton {
                                    text: field.value == "" ? "Choose " + field.label : field.value;
                                    icon: @image-url("../assets/icons/chevron-down.svg");
                                    accessible-label: "Choose " + field.label;
                                    horizontal-stretch: 1;
                                    clicked => { root.request-choices(field.id, true); }
                                }
                                if !field.has-choices && field.kind != EditorFieldKind.toggle: Rectangle {
                                    height: field.id == "message" ? 112px : 36px;
                                    horizontal-stretch: 1;
                                    background: Theme.field;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: 4px;
                                    TextInput {
