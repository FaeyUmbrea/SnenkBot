                                  height: parent.height;
 draft-active: root.control-mode == 1 && !root.value-visible;
                                  discard-draft(id) => { root.remove-control-child(id); }
                                  can-edit: !root.value-visible && root.can-edit-fields && !root.edit-pending && root.active-field == "" && !root.rename-active && root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode == 0; remove(id) => { root.remove-step(id); } move(id, direction) => { root.move-step(id, direction); } step: step; selected: root.selected-step == step.id; enabled: !root.value-visible && root.control-mode == 0 && root.action-mode != 2 && root.trigger-mode != 2; activate(id) => { root.selected-step = id; root.select-step(id); root.sidepanel-tab = 1; }
                                }
                                if step.depth > 0 && !step.group-end && !step.branch-header: Rectangle {
                                    x: min(step.depth, 5) * 20px - 9px;
                                    y: parent.height / 2;
                                    width: 17px;
                                    height: 1px;
                                    background: Theme.border;
                                }
                                if step.group-end: Rectangle {
                                    x: min(step.depth, 5) * 20px + 10px;
                                    y: 0px;
                                    width: parent.width - self.x - 26px;
                                    height: 1px;
                                    background: Theme.border;
                                }
                              }
                            }
                        }
                        if root.control-mode == 1 && root.control-target == "" && (root.control-kind == "one_or_more" || root.control-kind == "while" || root.control-kind == "if"): Rectangle {
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.amber;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;
                                Text { text: root.control-title; color: Theme.text; font-weight: 600; height: 32px; vertical-alignment: center; }
                                for child in root.control-children: Rectangle {
                                    height: 48px;
                                    HorizontalLayout {
                                        Text { text: child.title; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        IconButton { icon: @image-url("../assets/icons/x.svg"); accessible-label: "Remove " + child.title; clicked => { root.remove-control-child(child.kind); } }
                                    }
