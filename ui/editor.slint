                        if root.trigger-mode == 0 && root.action-mode == 2 && root.action-error != "": Text { text: root.action-error; color: Theme.gold; wrap: word-wrap; }
                        if root.control-mode == 1 && root.action-mode == 0: VerticalLayout {
                            spacing: 16px;
