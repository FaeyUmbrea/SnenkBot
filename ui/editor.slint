                            icon: @image-url("../assets/icons/arrow-left.svg");
                            clicked => { root.sidepanel-tab = 0; }
                        }
                        if root.trigger-mode == 1: Text { text: "Add trigger"; color: Theme.text; font-size: 17px; font-weight: 600; }
                        if root.trigger-mode == 1: Text { text: "A trigger starts this automation."; color: Theme.muted; font-size: 12px; }
                        if root.trigger-mode == 1: Rectangle { height: 20px; }
                        if root.trigger-mode == 1: VerticalLayout {
                            spacing: Theme.space-2;
                            for trigger in root.trigger-choices: TriggerChoiceRow {
                                trigger: trigger;
                                choose(kind) => { root.choose-trigger(kind); }
                            }
                        }
                        if root.trigger-mode == 2: Text { text: root.trigger-title; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                        if root.trigger-mode == 2: Text { text: "Configure trigger"; color: Theme.muted; font-size: 12px; }
                        if root.trigger-mode == 2: VerticalLayout {
                            spacing: Theme.space-3;
                            if root.trigger-kind == "obs.current_scene": VerticalLayout {
                                spacing: Theme.space-2;
                                Text { text: "Scene name"; color: Theme.text; font-size: 13px; font-weight: 600; }
