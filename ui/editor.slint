                            Text { text: root.workflow-title; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                            Rectangle {
                                height: 88px;
                                background: Theme.surface;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    HorizontalLayout {
                                        height: 44px;
                                        Text { text: "Enabled"; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                        WorkflowSwitch {
                                            checked: root.workflow-enabled;
                                            enabled: root.can-switch-detail-context;
                                            toggled => { root.set-workflow-enabled(!root.workflow-enabled); }
