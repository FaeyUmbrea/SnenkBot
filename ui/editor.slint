import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton, AppButton, AppCheckBox, AppTextField, ValueField } from "controls.slint";

export struct ValueSegment { text: string, is-output: bool, is-operator: bool, source-icon: image }
export enum StepIcon { automation, message, broadcast, control }
export enum EditorFieldKind { text, integer, toggle, secret }
export struct WorkflowStep { id: string, label: string, display-label: string, detail: string, icon: StepIcon, value: [ValueSegment], condition: [ValueSegment], suffix: string, control-kind: string, depth: int, group-end: bool, branch-header: bool, branch-empty: bool, parent-id: string, draft-child: bool }
export struct EditorField { id: string, label: string, description: string, value: string, kind: EditorFieldKind, editable: bool, is-output: bool, configured: bool, optional: bool, has-choices: bool }
export struct ActionChoice { capability: string, version: int, title: string, icon: StepIcon, group: string }
export struct ActionDraftField { id: string, label: string, description: string, value: string, kind: EditorFieldKind, required: bool, configured: bool, has-choices: bool }
export struct ResourceChoice { value: string, label: string, detail: string }
export struct ValueChoice { source: string, source-id: string, output-id: string, label: string, detail: string, optional: bool, fallback-kind: string }
export struct ControlChild { kind: string, title: string, removable: bool }
export struct ControlChoice { kind: string, title: string }
export struct ControlField { id: string, label: string, value: string, display-value: string, kind: EditorFieldKind, choices: [ControlChoice], editable: bool }
export struct TriggerChoice { kind: string, title: string, icon: StepIcon }


component ControlSelect inherits Rectangle {
    in property <[ControlChoice]> choices;
    in property <string> value;
    in property <string> display-value;
    in property <string> label;
    in property <bool> enabled: true;
    callback chosen(string);
    height: 36px;
    background: Theme.field;
    border-radius: 4px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.gold : Theme.border;
    accessible-role: button;
    accessible-label: root.label + ": " + root.display-value;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { menu.show(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        TouchArea { enabled: root.enabled; clicked => { focus.focus(); menu.show(); } }
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { menu.show(); return accept; } return reject; }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { text: root.display-value; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/chevron-down.svg"); colorize: Theme.text; width: 16px; height: 16px; } }
    }
    menu := PopupWindow {
        x: 0px;
        y: root.height;
        width: root.width;
        height: min(280px, root.choices.length * 38px + 16px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 6px;
            ScrollView {
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    for choice in root.choices: AppButton {
                        text: choice.title;
                        accessible-label: root.label + ": " + choice.title;
                        clicked => { menu.close(); root.chosen(choice.kind); }
                    }
                }
            }
        }
    }
}

component TriggerChoiceRow inherits Rectangle {
    in property <TriggerChoice> trigger;
    callback choose(string);
    height: 40px;
    background: Theme.surface;
    border-radius: 6px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.gold;
    accessible-role: button;
    accessible-label: "Add " + trigger.title;
    accessible-action-default => { root.choose(root.trigger.kind); }
    forward-focus: focus;
    focus := FocusScope {
        TouchArea { clicked => { focus.focus(); root.choose(root.trigger.kind); } }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.choose(root.trigger.kind);
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout { alignment: center; Image {
            source: root.trigger.icon == StepIcon.broadcast ? @image-url("../assets/icons/monitor.svg") : @image-url("../assets/icons/zap.svg");
            colorize: Theme.text;
            width: 18px;
            height: 18px;
        } }
        Text { text: root.trigger.title; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
        Rectangle { horizontal-stretch: 1; }
    }
}

component ActionChoiceRow inherits Rectangle {
    in property <ActionChoice> action;
    in property <bool> compound: false;
    in property <bool> enabled: true;
    callback choose(string, int);
    height: 32px;
    background: Theme.surface;
    border-radius: 6px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.gold;
    opacity: root.enabled ? 1 : 0.46;
    accessible-role: button;
    accessible-label: "Add " + action.title;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.choose(root.action.capability, root.action.version); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.choose(root.action.capability, root.action.version); } }
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
                root.choose(root.action.capability, root.action.version);
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start;
        VerticalLayout { alignment: center; Image {
            source: root.compound ? @image-url("../assets/icons/git-branch.svg") :
                root.action.group == "Lua" ? @image-url("../assets/icons/code.svg") :
                root.action.group == "VTube Studio" ? @image-url("../assets/icons/cable.svg") :
                root.action.icon == StepIcon.message ? @image-url("../assets/icons/message-circle.svg") :
                root.action.icon == StepIcon.broadcast ? @image-url("../assets/icons/monitor.svg") :
                root.action.icon == StepIcon.control ? @image-url("../assets/icons/keyboard.svg") :
                @image-url("../assets/icons/zap.svg");
            colorize: Theme.text;
            width: 16px;
            height: 16px;
        } }
        Text { text: root.action.title; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
    }
}

component ActionCategory inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <length> left-inset: 10px;
    callback choose;
    height: 32px;
    background: root.selected ? Theme.border : transparent;
    border-radius: 5px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.gold;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: "Show " + root.title + " actions";
    accessible-action-default => { if root.enabled { root.choose(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.choose(); } }
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
                root.choose();
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: root.left-inset;
        spacing: 8px;
        VerticalLayout { alignment: center; Image { source: root.icon; colorize: root.selected ? Theme.text : Theme.muted; width: 16px; height: 16px; } }
        Text { text: root.title; color: root.selected ? Theme.text : Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; }
    }
}

component WorkflowSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;
    width: 44px;
    height: 24px;
    background: root.checked ? Theme.blood : Theme.field;
    border-radius: 12px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.gold;
    opacity: root.enabled ? 1 : 0.46;
    accessible-role: button;
    accessible-label: root.checked ? "Disable workflow" : "Enable workflow";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.toggled(); } }
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        x: root.checked ? parent.width - 21px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        background: Theme.text;
        border-radius: 9px;
        accessible-role: none;
    }
}

export component StepRow inherits Rectangle {
    in property <bool> trigger: false;
    in property <WorkflowStep> step;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback activate(string);
    in property <bool> can-edit;
    in property <bool> draft-active;
    callback discard-draft(string);
    callback remove(string);
    callback move(string, int);
    height: root.trigger ? 72px : root.step.condition.length > 0 ? 60px : 56px;
    background: root.step.control-kind == "if" || root.step.control-kind == "while" || root.step.control-kind == "one_or_more" ? Theme.side : Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: selected || focus.has-focus ? Theme.amber : transparent;
    accessible-role: button;
    accessible-enabled: enabled;
    accessible-label: step.label;
    accessible-action-default => { if root.enabled { root.activate(root.step.id); } }
    forward-focus: focus;

    focus := FocusScope {
        enabled: root.enabled;
        TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activate(root.step.id); } }
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
                root.activate(root.step.id);
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        y: 0px;
        width: root.width;
        height: root.trigger ? 48px : parent.height;
        padding-left: 14px;
        padding-right: (root.can-edit || (root.draft-active && root.step.draft-child)) && !root.trigger ? 64px : 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        if root.trigger || root.step.control-kind != "" || root.step.icon != StepIcon.automation: VerticalLayout { alignment: center; Image {
            source: root.step.control-kind == "if" || root.step.control-kind == "while" || root.step.control-kind == "one_or_more" ? @image-url("../assets/icons/git-branch.svg") : root.step.control-kind != "" ? @image-url("../assets/icons/zap.svg") : root.step.icon == StepIcon.message ? @image-url("../assets/icons/message-circle.svg") :
                root.step.icon == StepIcon.broadcast ? @image-url("../assets/icons/monitor.svg") :
                root.step.icon == StepIcon.control ? @image-url("../assets/icons/keyboard.svg") :
                @image-url("../assets/icons/zap.svg");
            colorize: Theme.amber;
            width: 18px;
            height: 18px;
        } }
        Text { text: root.step.display-label != "" ? root.step.display-label : root.step.label; color: Theme.text; font-size: 14px; font-weight: root.step.control-kind == "if" || root.step.control-kind == "while" || root.step.control-kind == "one_or_more" ? 600 : 400; vertical-alignment: center; horizontal-stretch: 0; overflow: clip; max-width: root.step.condition.length > 0 ? 96px : root.width < 640px ? 170px : 320px; }
        if root.step.condition.length > 0: VerticalLayout { alignment: center; HorizontalLayout {
            height: 26px;
            spacing: 5px;
            for segment in root.step.condition: Rectangle {
                height: 26px;
                background: segment.is-operator ? transparent : segment.is-output ? #332A19 : Theme.field;
                border-width: segment.is-operator ? 0px : 1px;
                border-color: segment.is-output ? Theme.amber : Theme.border;
                border-radius: 4px;
                HorizontalLayout {
                    spacing: 4px;
                    padding-left: segment.is-operator ? 0px : 7px;
                    padding-right: segment.is-operator ? 0px : 7px;
                    if segment.is-output: VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/zap.svg"); colorize: Theme.gold; width: 13px; height: 13px; } }
                    Text { text: segment.text; color: segment.is-output ? Theme.gold : Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; max-width: 150px; }
                }
            }
        } }
        if root.step.value.length > 0: VerticalLayout { alignment: center; HorizontalLayout {
            height: 26px;
            spacing: 5px;
            for segment in root.step.value: Rectangle {
                height: 26px;
                background: segment.is-output ? #332A19 : Theme.field;
                border-width: 1px;
                border-color: segment.is-output ? Theme.amber : Theme.border;
                border-radius: 4px;
            HorizontalLayout {
                    spacing: 4px;
                    padding-left: 7px;
                    padding-right: 7px;
                    if segment.is-output: VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/zap.svg"); colorize: Theme.gold; width: 13px; height: 13px; } }
                    Text { text: segment.text; color: segment.is-output ? Theme.gold : Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; max-width: root.width < 640px ? 110px : 180px; }
                }
            }
        } }
        if root.step.suffix != "": Text { text: root.step.suffix; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.draft-active && root.step.draft-child: IconButton {
        x: root.width - 48px;
        y: (root.height - self.height) / 2;
        icon: @image-url("../assets/icons/x.svg");
        accessible-label: "Remove staged " + root.step.label;
        clicked => { root.discard-draft(root.step.id); }
    }
    if root.can-edit && !root.trigger: IconButton {
        x: root.width - 40px;
        y: (root.height - self.height) / 2;
        icon: @image-url("../assets/icons/ellipsis.svg");
        accessible-label: "Step options for " + root.step.label;
        enabled: root.enabled;
        clicked => { options.show(); }
    }
    if root.trigger: Image {
        x: root.width - 32px;
        y: 28px;
        width: 16px;
        height: 16px;
        source: @image-url("../assets/icons/chevron-down.svg");
        colorize: Theme.text;
        accessible-role: none;
    }
    if root.trigger: TouchArea {
        x: root.width - 40px;
        y: 16px;
        width: 40px;
        height: 40px;
        enabled: root.enabled;
        clicked => { focus.focus(); root.activate(root.step.id); }
    }
    options := PopupWindow {
        x: root.width - 184px;
        y: root.height - 8px;
        width: 176px;
        height: 132px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                AppButton { text: "Move up"; icon: @image-url("../assets/icons/chevron-up.svg"); clicked => { options.close(); root.move(root.step.id, -1); } }
                AppButton { text: "Move down"; icon: @image-url("../assets/icons/chevron-down.svg"); clicked => { options.close(); root.move(root.step.id, 1); } }
                AppButton { text: "Remove step"; icon: @image-url("../assets/icons/x.svg"); clicked => { options.close(); root.remove(root.step.id); } }
            }
        }
    }
    if root.trigger && root.step.detail != "": Text {
        x: 48px;
        y: 44px;
        width: parent.width - 64px;
        height: 16px;
        text: root.step.detail;
        color: Theme.muted;
        font-size: 12px;
        overflow: elide;
    }
}

// The controller supplies definitions and callbacks; this view owns no runtime behavior.
export component WorkflowEditor inherits Rectangle {
    in property <bool> workflow-enabled: true;
    callback set-workflow-enabled(bool);
    in-out property <bool> choice-visible;
    in property <bool> choice-loading;
    in property <string> choice-error;
    in property <string> choice-title;
    in property <[ResourceChoice]> choices;
    callback request-choices(string, bool);
    callback choose-resource(string);
    callback cancel-choices;
    in property <string> workflow-title;
    in property <string> saved-label;
    in property <bool> can-run: false;
    in property <bool> can-add-trigger: false;
    in property <bool> can-add-action: false;
    in property <bool> can-rename: false;
    in property <bool> can-edit-fields: false;
    in property <bool> can-show-history: true;
    in property <[WorkflowStep]> triggers;
    in property <[WorkflowStep]> steps;
    in property <[EditorField]> inspector-fields;
    in-out property <string> active-field;
    in-out property <string> draft-value;
    in-out property <string> edit-error;
    in property <bool> edit-pending: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in-out property <string> selected-step;
    in-out property <int> sidepanel-tab: 0;
    in-out property <string> action-category: "all";
    in-out property <bool> rename-active: false;
    in-out property <string> rename-draft;
    in-out property <bool> value-visible: false;
    in-out property <string> value-slot;
    in-out property <[ValueChoice]> value-choices;
    in-out property <int> value-selected: -1;
    in-out property <string> value-fallback-kind;
    in-out property <string> value-fallback-value;
    in-out property <string> value-error;
    callback request-control-values(string);
    callback request-action-values(string);
    callback request-action-literal(string);
    callback request-control-literal(string);
    callback select-control-value(int);
    callback set-value-fallback(string, string);
    callback confirm-control-value();
    callback cancel-control-values();
    in-out property <int> control-mode: 0;
    in property <string> control-kind;
    in property <string> control-target;
    in property <string> control-title;
    in property <string> control-parent-title;
    in property <[ControlField]> control-fields;
    in property <string> control-error;
    in property <[ControlChoice]> control-choices;
    in property <[ControlChild]> control-children;
    in property <string> control-insert-parent;
    in property <string> control-insert-branch;
    in property <[ControlChoice]> control-input-types;
    callback begin-control(string);
    callback edit-control(string);
    callback update-control-field(string, string);
    callback save-control();
    callback cancel-control();
    callback begin-control-child(string);
    callback remove-control-child(string);
    callback add-child(string, string);
    callback set-control-input-type(string, string);
    in-out property <int> action-mode: 0;
    in property <[ActionChoice]> action-choices;
    in-out property <string> action-query;
    in property <string> action-title;
    in property <[ActionDraftField]> action-fields;
    in-out property <string> action-error;
    in-out property <int> trigger-mode: 0;
    in property <[TriggerChoice]> trigger-choices;
    in-out property <string> trigger-kind;
    in property <string> trigger-title;
    in-out property <string> trigger-scene;
    in-out property <string> trigger-error;
    in-out property <bool> trigger-editing: false;
    in-out property <string> trigger-edit-kind;
    in-out property <string> trigger-edit-scene;
    in-out property <string> trigger-edit-command;
    in-out property <string> trigger-edit-aliases;
    in-out property <bool> trigger-edit-moderator: false;
    in property <bool> trigger-pending: false;
    in property <bool> selected-trigger-enabled: false;
    callback back;
    callback run;
    callback history;
    callback add-trigger;
    callback add-action;
    callback select-step(string);
    callback apply-field(string, string, string);
    callback remove-field(string, string);
    callback apply-name(string);
    callback undo;
    callback redo;
    callback search-actions(string);
    callback choose-action(string, int);
    callback remove-step(string);
    callback move-step(string, int);
    private property <bool> can-switch-detail-context: root.control-mode == 0 && root.action-mode == 0 && root.trigger-mode == 0 && !root.trigger-editing && root.active-field == "" && !root.rename-active && !root.choice-visible && !root.value-visible && !root.edit-pending && !root.trigger-pending;
    callback update-action-field(int, string, bool);
    callback save-action;
    callback cancel-action;
    callback choose-trigger(string);
    callback save-trigger;
    callback cancel-trigger;
    callback set-trigger-enabled(string, bool);
    callback edit-trigger(string);
    callback save-trigger-edit();
    callback cancel-trigger-edit();
    background: Theme.ink;

    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: Theme.toolbar-height;
            padding-left: 16px;
            padding-right: Theme.inspector-width + 24px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 16px;
            IconButton { icon: @image-url("../assets/icons/arrow-left.svg"); accessible-label: !root.value-visible && root.control-parent-title != "" && root.action-mode == 0 ? "Back to " + root.control-parent-title : root.value-visible || root.control-mode != 0 || root.trigger-mode != 0 ? "Back to editor" : root.action-mode == 2 ? "Back to actions" : root.action-mode == 1 ? "Back to editor" : "Back to automations"; enabled: !root.edit-pending && !root.trigger-pending && (root.active-field == "" || root.choice-visible) && !root.rename-active; clicked => { root.back(); } }
            if !root.rename-active: Text { text: root.workflow-title; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if !root.rename-active && root.can-rename: IconButton { icon: @image-url("../assets/icons/pencil.svg"); accessible-label: "Rename workflow"; enabled: !root.value-visible && !root.edit-pending && root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode == 0 && root.active-field == ""; clicked => { root.rename-draft = root.workflow-title; root.rename-active = true; } }
            if root.rename-active: Rectangle {
                height: 32px;
                horizontal-stretch: 1;
                background: Theme.field;
                border-width: 1px;
                border-color: name-edit.has-focus ? Theme.gold : Theme.border;
                border-radius: 4px;
                name-edit := TextInput {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 20px;
                    height: 22px;
                    text <=> root.rename-draft;
                    accessible-label: "Workflow name";
                    color: Theme.text;
                    selection-background-color: Theme.blood;
                    selection-foreground-color: Theme.text;
                    enabled: !root.edit-pending;
                    single-line: true;
                }
            }
            if root.rename-active: IconButton { icon: @image-url("../assets/icons/x.svg"); accessible-label: "Cancel rename"; enabled: !root.edit-pending; clicked => { root.rename-active = false; root.rename-draft = ""; } }
            if root.rename-active: IconButton { icon: @image-url("../assets/icons/check.svg"); accessible-label: "Save name"; primary: true; enabled: !root.edit-pending; clicked => { root.apply-name(root.rename-draft); } }
            if !root.rename-active: Text { text: root.saved-label; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
            if root.can-show-history: IconButton { icon: @image-url("../assets/icons/history.svg"); accessible-label: "Run history"; enabled: !root.value-visible && root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode == 0; clicked => { root.history(); } }
            if root.can-undo && !root.rename-active: IconButton { icon: @image-url("../assets/icons/undo.svg"); accessible-label: "Undo edit"; enabled: !root.value-visible && root.can-undo && root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode == 0 && !root.edit-pending && root.active-field == ""; clicked => { root.undo(); } }
            if root.can-redo && !root.rename-active: IconButton { icon: @image-url("../assets/icons/redo.svg"); accessible-label: "Redo edit"; enabled: !root.value-visible && root.can-redo && root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode == 0 && !root.edit-pending && root.active-field == ""; clicked => { root.redo(); } }
            if !root.rename-active: IconButton { icon: @image-url("../assets/icons/play.svg"); accessible-label: "Run automation"; primary: true; enabled: !root.value-visible && root.can-run && root.control-mode == 0 && root.trigger-mode == 0 && root.action-mode == 0 && !root.edit-pending && root.active-field == ""; clicked => { root.run(); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            spacing: 0px;
            VerticalLayout {
                spacing: 0px;
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
