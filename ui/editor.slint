                        HorizontalLayout {
                            spacing: 4px;
                            ActionCategory { title: "All Actions"; icon: @image-url("../assets/icons/zap.svg"); selected: root.action-category == "all"; width: (Theme.inspector-width - 52px) / 2; choose => { root.action-category = "all"; root.search-actions(root.action-query); } }
                            ActionCategory { title: "Flow"; icon: @image-url("../assets/icons/git-branch.svg"); selected: root.action-category == "flow"; width: (Theme.inspector-width - 52px) / 2; choose => { root.action-category = "flow"; root.search-actions(root.action-query); } }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            ActionCategory { title: "Lua"; icon: @image-url("../assets/icons/code.svg"); selected: root.action-category == "lua"; width: (Theme.inspector-width - 52px) / 2; choose => { root.action-category = "lua"; root.search-actions(root.action-query); } }
                            ActionCategory { title: "Twitch"; icon: @image-url("../assets/icons/message-circle.svg"); selected: root.action-category == "twitch"; width: (Theme.inspector-width - 52px) / 2; choose => { root.action-category = "twitch"; root.search-actions(root.action-query); } }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            ActionCategory { title: "OBS"; icon: @image-url("../assets/icons/monitor.svg"); selected: root.action-category == "obs"; width: (Theme.inspector-width - 52px) / 2; choose => { root.action-category = "obs"; root.search-actions(root.action-query); } }
                            ActionCategory { title: "VTube Studio"; icon: @image-url("../assets/icons/cable.svg"); selected: root.action-category == "vtube"; width: (Theme.inspector-width - 52px) / 2; choose => { root.action-category = "vtube"; root.search-actions(root.action-query); } }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        Rectangle { height: 4px; }
                        for action[index] in root.action-choices: VerticalLayout {
