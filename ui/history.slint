import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppButton, IconButton } from "controls.slint";

export struct HistoryStep {
    sequence: string, number: string, depth: int, title: string, step-id: string,
    workflow-id: string, workflow-revision: string, started-at: string,
    duration: string, outcome: string, failure: string,
    uncertain: bool, continued: bool,
}

export struct HistoryRow {
    run-id: string,
    workflow-id: string,
    title: string,
    outcome: string,
    trigger: string,
    trigger-id: string,
    started-at: string,
    duration: string,
    workflow-revision: string,
    script-activity: string,
    steps: [HistoryStep],
    error: string,
    is-corrupt: bool,
}

component HistoryListRow inherits Rectangle {
    in property <HistoryRow> item;
    callback activate;

    height: 48px;
    background: Theme.side;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: focus.has-focus ? Theme.gold : Theme.border;
    accessible-role: button;
    accessible-label: item.is-corrupt ? "Inspect unreadable run record " + item.run-id : "Inspect run of " + item.title + ", " + item.outcome;
    accessible-action-default => { root.activate(); }
    forward-focus: focus;

    focus := FocusScope {
        TouchArea { clicked => { focus.focus(); root.activate(); } }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        Text {
            text: item.title;
            color: item.is-corrupt ? Theme.gold : Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: item.outcome + (item.error == "" ? "" : " · " + item.error) + " · " + item.duration + " · " + item.started-at;
            color: item.is-corrupt || item.error != "" ? Theme.gold : Theme.muted;
            vertical-alignment: center;
            width: 48%;
            overflow: elide;
        }

    }
}

component HistoryTraceRow inherits Rectangle {
    in property <HistoryStep> step;
    in property <bool> selected;
    callback activate;
    height: 64px;
    min-width: 0px;
    background: root.selected ? Theme.surface : Theme.side;
    border-width: root.selected || focus.has-focus ? 1px : 0px;
    border-color: Theme.gold;
    border-radius: 8px;
    accessible-role: button;
    accessible-label: "Inspect " + root.step.title + ", " + root.step.outcome;
    accessible-action-default => { root.activate(); }
    forward-focus: focus;
    focus := FocusScope {
        TouchArea { clicked => { focus.focus(); root.activate(); } }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activate(); return accept; }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Text { text: root.step.number + "  " + root.step.title; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.step.outcome + " · " + root.step.duration; color: root.step.failure != "" ? Theme.gold : Theme.muted; width: 34%; vertical-alignment: center; overflow: elide; }
    }
}

export component RunHistory inherits Rectangle {
    in property <[HistoryRow]> run-history;
    in property <string> history-error;
    in property <bool> history-loading;
    private property <string> inspected-step: "";
    private property <string> inspected-run-id: "";
    private property <HistoryStep> inspected-record;
    private property <bool> show-inspected-step: root.inspected-step != "" && root.inspected-run-id == root.selected-run-id;
    private property <bool> failed-only: false;
    private property <bool> search-visible: false;
    private property <string> query;
    private property <[HistoryRow]> visible-runs: root.filter-history(root.run-history, root.failed-only, root.query);
    pure callback filter-history([HistoryRow], bool, string) -> [HistoryRow];
    in-out property <string> selected-run-id: "";
    in-out property <HistoryRow> selected-record;
    in property <bool> can-return-to-workflow;
    callback return-to-workflow;
    callback refresh-history;
    callback open-history-workflow(string);

    background: Theme.ink;

    if root.selected-run-id == "": VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: Theme.toolbar-height;
            padding-left: Theme.space-6;
            padding-right: Theme.inspector-width + Theme.space-6;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: Theme.space-3;
            if root.can-return-to-workflow: IconButton {
                icon: @image-url("../assets/icons/arrow-left.svg");
                accessible-label: "Back to automation";
                clicked => { root.return-to-workflow(); }
            }
            Text {
                text: "Run history";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.history-loading: Text { text: "Refreshing…"; color: Theme.muted; vertical-alignment: center; }
            AppButton {
                text: "Refresh";
                enabled: !root.history-loading;
                clicked => { root.refresh-history(); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if root.history-error != "": Rectangle {
            background: Theme.side;
            width: 100%;
            VerticalLayout {
                padding-left: Theme.space-6;
                padding-right: Theme.space-6;
                padding-top: Theme.space-2;
                padding-bottom: Theme.space-2;
                Text { text: root.history-error; color: Theme.gold; wrap: word-wrap; }
            }
        }
        VerticalLayout {
            padding-left: Theme.space-6;
            padding-right: Theme.space-6;
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-6;
            spacing: 0px;
            max-width: 1180px;
            HorizontalLayout {
                height: 32px;
                spacing: 12px;
                AppButton { text: "All runs"; width: 115px; primary: !root.failed-only; clicked => { root.failed-only = false; } }
                AppButton { text: "Failed"; width: 96px; primary: root.failed-only; clicked => { root.failed-only = true; } }
                Rectangle { horizontal-stretch: 1; }
                if root.search-visible: Rectangle {
                    width: 260px;
                    height: 32px;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 4px;
                    TextInput { x: 10px; y: 5px; width: parent.width - 20px; height: 22px; text <=> root.query; color: Theme.text; single-line: true; accessible-label: "Search run history"; }
                }
                IconButton { icon: root.search-visible ? @image-url("../assets/icons/x.svg") : @image-url("../assets/icons/search.svg"); accessible-label: root.search-visible ? "Close history search" : "Search run history"; clicked => { root.search-visible = !root.search-visible; root.query = ""; } }
            }
            Rectangle { height: 28px; }
            Rectangle {
                height: 48px;
                background: Theme.side;
                HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-3;
                Text { text: "Automation"; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: "Result / time"; color: Theme.text; width: 48%; vertical-alignment: center; }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            ScrollView {
                VerticalLayout {
                    spacing: 8px;
                    if root.visible-runs.length == 0: Text {
                        text: root.history-loading ? "Loading run history…" : root.run-history.length == 0 ? "No workflow runs yet." : "No matching runs.";
                        color: Theme.muted;
                        x: Theme.space-3;
                    }
                    for item in root.visible-runs: HistoryListRow {
                        item: item;
                        activate => { root.inspected-step = ""; root.selected-run-id = item.run-id; root.selected-record = item; }
                    }
                }
            }
        }
    }

    if root.selected-run-id != "": VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: Theme.toolbar-height;
            padding-left: Theme.space-6;
            padding-right: Theme.inspector-width + Theme.space-6;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: Theme.space-3;
            IconButton {
                icon: @image-url("../assets/icons/arrow-left.svg");
                accessible-label: "Back to run history";
                clicked => { root.selected-run-id = ""; }
            }
            Text {
                text: root.selected-record.is-corrupt ? "Unreadable run record" : root.selected-record.title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if !root.selected-record.is-corrupt: AppButton {
                text: "Open automation";
                clicked => { root.open-history-workflow(root.selected-record.workflow-id); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            spacing: 0px;
            VerticalLayout {
                spacing: 0px;
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding: Theme.space-6;
                        spacing: 0px;
                        alignment: start;
                        if !root.selected-record.is-corrupt: Text { text: "Triggers"; color: Theme.muted; font-size: 13px; height: 40px; vertical-alignment: center; }
                        if !root.selected-record.is-corrupt: Rectangle {
                            height: 72px;
                            background: Theme.side;
                            border-radius: 8px;
                            VerticalLayout {
                                padding-left: Theme.space-4;
                                padding-right: Theme.space-4;
                                padding-top: Theme.space-3;
                                padding-bottom: Theme.space-3;
                                spacing: Theme.space-1;
                                Text { text: root.selected-record.trigger; color: Theme.text; overflow: elide; }
                                if root.selected-record.trigger-id != "": Text { text: "Trigger ID: " + root.selected-record.trigger-id; color: Theme.muted; font-size: 12px; overflow: elide; }
                            }
                        }
                        if !root.selected-record.is-corrupt: Rectangle { height: 16px; }
                        Text { text: root.selected-record.is-corrupt ? "Run record" : "Actions"; color: Theme.muted; font-size: 13px; height: 24px; vertical-alignment: center; }
                        if !root.selected-record.is-corrupt: Rectangle { height: 8px; }
                        if root.selected-record.is-corrupt: Rectangle {
                            background: Theme.side;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: Theme.space-4;
                                spacing: Theme.space-2;
                                Text { text: "This run record could not be read."; color: Theme.text; font-weight: 600; }
                                Text { text: "The original file is unchanged. Fix the JSON file, then refresh to try loading it again."; color: Theme.muted; wrap: word-wrap; }
                                Text { text: root.selected-record.error; color: Theme.gold; wrap: word-wrap; }
                            }
                        }
                        if !root.selected-record.is-corrupt && root.selected-record.steps.length == 0: Text {
                            text: root.selected-record.outcome == "Running" ? "Step details appear when this run finishes." : "No step trace was saved for this run.";
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        if !root.selected-record.is-corrupt: VerticalLayout {
                            spacing: 12px;
                            for step in root.selected-record.steps: HorizontalLayout {
                                spacing: 0px;
                                Rectangle { width: min(step.depth, 5) * 20px; }
                                HistoryTraceRow {
                                    horizontal-stretch: 1;
                                    step: step;
                                    selected: root.show-inspected-step && root.inspected-step == step.sequence;
                                    activate => {
                                        root.inspected-step = root.show-inspected-step && root.inspected-step == step.sequence ? "" : step.sequence;
                                        root.inspected-run-id = root.selected-run-id;
                                        root.inspected-record = step;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 24px; }
                    }
                }
                Rectangle {
                    height: 36px;
                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding-left: Theme.space-6;
                        padding-right: Theme.space-6;
                        Text { text: root.selected-record.is-corrupt ? "Unreadable run" : root.selected-record.steps.length + " recorded steps"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        if !root.selected-record.is-corrupt: Text { text: root.selected-record.duration; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }
            Rectangle {
                width: Theme.inspector-width;
                background: Theme.side;
                Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.border; }
                VerticalLayout {
                    spacing: 0px;
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding: Theme.space-6;
                            spacing: Theme.space-2;
                            alignment: start;
                            Text { text: root.show-inspected-step ? root.inspected-record.title : root.selected-record.is-corrupt ? "Unreadable run" : root.selected-record.outcome == "Succeeded" ? "Successful run" : root.selected-record.outcome == "Running" ? "Running automation" : root.selected-record.outcome == "Cancelled" ? "Cancelled run" : root.selected-record.outcome + " run"; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                            Text { text: root.show-inspected-step ? "Step " + root.inspected-record.number + " · " + root.inspected-record.outcome : root.selected-record.started-at; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            Rectangle { height: 20px; }
                            if !root.show-inspected-step && !root.selected-record.is-corrupt: Text {
                                text: root.selected-record.outcome == "Succeeded" ? "Completed in " + root.selected-record.duration : root.selected-record.outcome == "Running" ? "Step details appear when this run finishes." : root.selected-record.outcome == "Cancelled" ? "Actions already completed are not undone." : root.selected-record.outcome;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            if root.show-inspected-step: VerticalLayout {
                                spacing: Theme.space-3;
                                Text { text: root.inspected-record.failure == "" ? root.inspected-record.outcome : root.inspected-record.failure; color: root.inspected-record.failure != "" ? Theme.gold : Theme.text; wrap: word-wrap; }
                                if root.inspected-record.uncertain: Text { text: "The remote action may have completed before this failure. Check its result before running it again."; color: Theme.gold; wrap: word-wrap; }
                                if root.inspected-record.continued: Text { text: "This step’s failure policy allowed the workflow to continue."; color: Theme.muted; wrap: word-wrap; }
                                Text { text: "Started " + root.inspected-record.started-at + " · " + root.inspected-record.duration; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                Text { text: "Step ID: " + root.inspected-record.step-id; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                Text { text: "Workflow " + root.inspected-record.workflow-id + " · revision " + root.inspected-record.workflow-revision; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                Rectangle { height: 12px; }
                                Rectangle { height: 1px; background: Theme.border; }
                                Rectangle { height: 12px; }
                            }
                            if !root.selected-record.is-corrupt: VerticalLayout {
                                spacing: Theme.space-3;
                                Text { text: "Result · " + root.selected-record.outcome; color: root.selected-record.error != "" ? Theme.gold : Theme.text; wrap: word-wrap; }
                                if root.selected-record.error != "": Text { text: root.selected-record.error; color: Theme.gold; wrap: word-wrap; }
                                Text { text: "Trigger · " + root.selected-record.trigger; color: Theme.muted; wrap: word-wrap; }
                                if root.selected-record.trigger-id != "": Text { text: "Trigger ID: " + root.selected-record.trigger-id; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                Text { text: "Duration · " + root.selected-record.duration; color: Theme.muted; wrap: word-wrap; }
                                Text { text: "Workflow revision · " + root.selected-record.workflow-revision; color: Theme.muted; wrap: word-wrap; }
                                Rectangle { height: 12px; }
                                Rectangle { height: 1px; background: Theme.border; }
                                Rectangle { height: 12px; }
                                Text { text: "Script activity"; color: Theme.text; font-weight: 600; }
                                Text { text: root.selected-record.script-activity == "" ? "No script activity was recorded for this run." : root.selected-record.script-activity; color: Theme.muted; wrap: word-wrap; }
                                Text { text: "Script source and variable values are not stored in run history."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            }
                            Text { text: "Run ID: " + root.selected-record.run-id; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            alignment: end;
                            padding-left: Theme.space-6;
                            padding-right: Theme.space-6;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            AppButton { text: "Back to history"; primary: true; width: 168px; clicked => { root.selected-run-id = ""; } }
                        }
                    }
                }
            }
        }
    }
}
